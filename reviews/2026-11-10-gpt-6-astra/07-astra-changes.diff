+class FakeEmbedder:
+    def get(self, texts):
+        vectors = []
+        for text in texts:
+            if text == "apple":
+                vectors.append(np.array([0.0, 1.0]))
+            elif "apple" in text:
+                vectors.append(np.array([1.0, 0.0]))
+            elif "pear" in text:
+                vectors.append(np.array([0.0, 1.0]))
+            else:
+                vectors.append(np.array([-1.0, 0.0]))
+        return vectors
+

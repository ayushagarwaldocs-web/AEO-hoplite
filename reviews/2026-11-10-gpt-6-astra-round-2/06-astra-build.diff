index 0000000..05762e2
--- /dev/null
+++ b/experiments/exp2_content_treatments/followup_common.py
@@ -0,0 +1,208 @@
+"""Offline utilities for the dated follow-up; never called by the main analysis."""
+from __future__ import annotations
+
+import contextlib
+import fcntl
+import hashlib
+import json
+import math
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+SCHEMA_VERSION = 1
+SEED = 20261110
+
+
+def timestamp():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+
+
+def read_jsonl(path):
+    path = Path(path)
+    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()] if path.exists() else []
+
+
+def write_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, allow_nan=False) + "\n")
+
+
+def write_jsonl(path, rows):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text("".join(json.dumps(r, allow_nan=False) + "\n" for r in rows))
+
+
+def append_jsonl(path, row):
+    with Path(path).open("a") as f:
+        f.write(json.dumps(row, allow_nan=False) + "\n")
+        f.flush()
+        import os
+        os.fsync(f.fileno())
+
+
+@contextlib.contextmanager
+def exclusive(path):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.with_suffix(path.suffix + ".lock").open("a") as f:
+        try:
+            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise ValueError("Another runner owns this output") from exc
+        yield
+
+
+@contextlib.contextmanager
+def execution_settings():
+    values = {k: os.environ.get(k) for k in ('AEO_TEMPERATURE', 'AEO_NO_RETRIES')}
+    os.environ.update(AEO_TEMPERATURE='0', AEO_NO_RETRIES='1')
+    try:
+        yield
+    finally:
+        for key, value in values.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
+                os.environ[key] = value
+
+
+def request_ceiling(spec, system, user, max_tokens):
+    from aeotools.llm import estimate_cost
+    if type(max_tokens) is not int or max_tokens <= 0:
+        raise ValueError("Output token limit must be positive")
+    # Byte-count input allowance is deliberately more conservative than chars/4 planning.
+    return estimate_cost(spec, len((system + user).encode()) + 256, max_tokens)
+
+
+class BudgetLog:
+    """Reserve before calls; refuse ambiguous interrupted calls on resume."""
+    def __init__(self, output, fingerprint, total_cap, model_caps=None):
+        self.output = Path(output)
+        self.output.parent.mkdir(parents=True, exist_ok=True)
+        self.journal = self.output.with_suffix(self.output.suffix + ".requests.jsonl")
+        self.rows = read_jsonl(self.output)
+        self.requests = read_jsonl(self.journal)
+        self.fingerprint = fingerprint
+        self.total_cap, self.model_caps = total_cap, model_caps or {}
+        if not math.isfinite(total_cap) or total_cap <= 0:
+            raise ValueError("Spending cap must be positive and finite")
+        if any(not math.isfinite(v) or v <= 0 for v in self.model_caps.values()):
+            raise ValueError("Per-model caps must be positive and finite")
+        if any(r.get("fingerprint") != fingerprint for r in self.rows + self.requests):
+            raise ValueError("Resume fingerprint differs: use a new output for a new protocol/settings")
+        completed = {r["request_id"] for r in self.rows}
+        if len(completed) != len(self.rows) or completed != {r['request_id'] for r in self.requests}:
+            raise ValueError("Unsettled request or inconsistent journal; reconcile before resuming")
+        if any(r["request_id"] not in completed for r in self.requests):
+            raise ValueError("Unsettled request: reconcile provider usage and journal before resuming; no automatic retry")
+        self.by_model = {}
+        for row in self.rows:
+            charge = float(row["budget_charge_usd"])
+            self.by_model[row["model"]] = self.by_model.get(row["model"], 0) + charge
+
+    @property
+    def spent(self):
+        return sum(self.by_model.values())
+
+    def permits(self, spec, reservation):
+        return (self.spent + reservation <= self.total_cap + 1e-12 and
+                self.by_model.get(spec, 0) + reservation <= self.model_caps.get(spec, self.total_cap) + 1e-12)
+
+    def start(self, spec, item_id, reservation):
+        if not self.permits(spec, reservation):
+            raise ValueError("Insufficient budget reservation")
+        row = {"request_id": digest([self.fingerprint, spec, item_id, len(self.requests)]),
+               "fingerprint": self.fingerprint, "model": spec, "item_id": item_id,
+               "reserved_usd": reservation, "started_at": timestamp()}
+        append_jsonl(self.journal, row)
+        self.requests.append(row)
+        return row
+
+    def finish(self, request, row):
+        cost = float(row.get("cost_usd", 0))
+        if not math.isfinite(cost) or cost < 0:
+            raise ValueError("Invalid reported cost; reconcile the unsettled request")
+        missing_usage = not row.get("input_tokens") or not row.get("output_tokens")
+        charge = max(cost, request["reserved_usd"]) if missing_usage else cost
+        record = {**request, **row, "completed_at": timestamp(), "budget_charge_usd": charge,
+                  "usage_unresolved": missing_usage}
+        append_jsonl(self.output, record)
+        self.rows.append(record)
+        spec = request["model"]
+        self.by_model[spec] = self.by_model.get(spec, 0) + charge
+        if charge > request["reserved_usd"] + 1e-12:
+            raise ValueError("Reported charge exceeded reservation; stop and review provider/settings")
+        return record
+
+
+def holm(values):
+    order = np.argsort(values)
+    adjusted = np.empty(len(values))
+    bound = 0.
+    for rank, idx in enumerate(order):
+        bound = max(bound, min(1., values[idx] * (len(values) - rank)))
+        adjusted[idx] = bound
+    return adjusted.tolist()
+
+
+def effect(rows, *, n_boot=4000, n_perm=10000, seed=SEED, developers=None):
+    """Equal-model estimates; common scenario resampling/signs preserve model dependence."""
+    if rows.empty:
+        return {"effect": None, "ci_low": None, "ci_high": None, "p": None,
+                "n_pairs": 0, "n_models": 0, "n_scenarios": 0}
+    if rows.duplicated(["model", "scenario", "trial_id"]).any():
+        raise ValueError("Duplicate paired trials")
+    agg = rows.groupby(["scenario", "model"]).delta.agg(["sum", "count"])
+    sums = agg["sum"].unstack(fill_value=0)
+    counts = agg["count"].unstack(fill_value=0).reindex_like(sums)
+    a, b = sums.to_numpy(), counts.to_numpy()
+    weights = np.ones(a.shape[1]) / a.shape[1]
+    if developers:
+        groups = [developers[m] for m in sums.columns]
+        weights = np.array([1 / (len(set(groups)) * groups.count(g)) for g in groups])
+    observed = float((a.sum(0) / b.sum(0)) @ weights)
+    rng = np.random.default_rng(seed)
+    indices = rng.integers(0, len(a), (n_boot, len(a)))
+    denom = b[indices].sum(1)
+    valid = (denom > 0).all(1)
+    boot = (a[indices].sum(1)[valid] / denom[valid]) @ weights
+    signs = rng.choice([-1., 1.], (n_perm, len(a)))
+    null = ((signs @ a) / b.sum(0)) @ weights
+    lo, hi = np.quantile(boot, [.025, .975])
+    return {"effect": observed, "ci_low": float(lo), "ci_high": float(hi),
+            "p": float((1 + (abs(null) >= abs(observed) - 1e-12).sum()) / (n_perm + 1)),
+            "n_pairs": len(rows), "n_models": a.shape[1], "n_scenarios": len(a),
+            "bootstrap_valid": int(valid.sum()), "bootstrap_requested": n_boot}
+
+
+def agreement(a, b):
+    pairs = [(x, y) for x, y in zip(a, b) if x is not None and y is not None]
+    table = [[0, 0], [0, 0]]
+    for x, y in pairs:
+        table[int(x)][int(y)] += 1
+    n = len(pairs)
+    if not n:
+        return {"n": 0, "confusion": table, "agreement": None, "kappa": None}
+    observed = (table[0][0] + table[1][1]) / n
+    pa = sum(x for x, _ in pairs) / n
+    pb = sum(y for _, y in pairs) / n
+    expected = pa * pb + (1 - pa) * (1 - pb)
+    return {"n": n, "confusion": table, "agreement": observed,
+            "kappa": (observed - expected) / (1 - expected) if expected < 1 else None}
+
+
+def require_private(*paths):
+    root = Path(__file__).resolve().parent / 'data' / 'private'
+    for path in paths:
+        if not Path(path).resolve().is_relative_to(root.resolve()):
+            raise ValueError(f'Private follow-up material must remain under {root}')
diff --git a/experiments/exp2_content_treatments/make_recommendation_manifest.py b/experiments/exp2_content_treatments/make_recommendation_manifest.py
new file mode 100644
index 0000000..e688b1d
--- /dev/null
+++ b/experiments/exp2_content_treatments/make_recommendation_manifest.py
@@ -0,0 +1,137 @@
+"""Freeze private blinded inputs and disjoint splits for the exploratory outcome."""
+import argparse
+import hashlib
+import random
+import re
+from collections import defaultdict
+from pathlib import Path
+
+from build_corpus import build
+from followup_common import SEED, digest, read_jsonl, write_json, write_jsonl, timestamp
+from recommendation_protocol import CONDITIONS, PANEL_CONDITIONS, CODEBOOK, SYSTEM
+from attribution import ATTRIBUTION
+from scenarios import SCENARIOS
+
+HERE = Path(__file__).resolve().parent
+
+
+def freeze(records, directory, freeze_time, dataset='main'):
+    if not re.fullmatch(r'(?:[01]\d|2[0-3]):[0-5]\d IST', freeze_time):
+        raise ValueError('Supply actual freeze time HH:MM IST, not the placeholder')
+    directory = Path(directory)
+    if directory.exists() and any(directory.iterdir()):
+        raise ValueError('Manifest directory is immutable; choose a new empty directory')
+    wanted = CONDITIONS if dataset == 'main' else ATTRIBUTION
+    queries = {s['id']: s['query'] for s in SCENARIOS}
+    canonical = {i['trial_id']: i for i in build(3, ['baseline'])}
+    selected = [r for r in records if r['condition'] in wanted and not r.get('error')]
+    selected.sort(key=lambda r: (r['model'], r['condition'], r['trial_id']))
+    keys, manifest, cells = [], [], defaultdict(list)
+    seen = set()
+    for r in selected:
+        identity = [r['model'], r['condition'], r['trial_id']]
+        if tuple(identity) in seen:
+            raise ValueError('Duplicate successful source response')
+        seen.add(tuple(identity))
+        if r['trial_id'] not in canonical or r['scenario'] != canonical[r['trial_id']]['scenario'] or r['target'] != canonical[r['trial_id']]['target']:
+            raise ValueError('Response does not match frozen main trial/scenario/target')
+        item_id = digest([SEED, dataset, identity])[:24]
+        manifest.append(dict(item_id=item_id, query=queries[r['scenario']], target=r['target'], answer=r['text']))
+        keys.append(dict(item_id=item_id, dataset=dataset, model=r['model'], condition=r['condition'],
+                         trial_id=r['trial_id'], scenario=r['scenario'], role='remaining',
+                         selection_probability=None, selection_design='census'))
+        cells[(r['model'], r['condition'])].append(item_id)
+    models = sorted({r['model'] for r in selected})
+    if dataset == 'main' and (len(models) != 12 or len(selected) != 7560 or any(len(v) != 90 for v in cells.values())):
+        raise ValueError('Main recommendation manifest requires 12 models x 90 trials x 7 conditions')
+    if not selected:
+        raise ValueError('No successful answers')
+    key = {r['item_id']: r for r in keys}
+    lookup = {r['item_id']: r for r in manifest}
+    rng = random.Random(SEED)
+    splits = dict(pilot=[], practice=[], probability=[], challenge=[], repeats=[])
+
+    def take(ids, role, probability=None, design='purposive diagnostic'):
+        for item in ids:
+            key[item].update(role=role, selection_probability=probability, selection_design=design)
+        splits[role].extend(ids)
+
+    if dataset == 'main':
+        for cell in sorted(cells):
+            take([rng.choice(cells[cell])], 'pilot', 1 / 90, 'one random item per model x condition cell')
+        shuffled_models, shuffled_conditions = models[:], PANEL_CONDITIONS[:]
+        rng.shuffle(shuffled_models)
+        rng.shuffle(shuffled_conditions)
+        for c, condition in enumerate(shuffled_conditions):
+            for j in range(8):
+                model = shuffled_models[(2 * c + j) % 12]
+                eligible = [i for i in cells[(model, condition)] if key[i]['role'] == 'remaining']
+                take([rng.choice(eligible)], 'probability', (8 / 12) / len(eligible),
+                     'conditional on pilot: randomized balanced cell allocation, then SRS within cell')
+        for condition in PANEL_CONDITIONS:
+            eligible = [r['item_id'] for r in keys if r['condition'] == condition and r['role'] == 'remaining']
+            take([rng.choice(eligible)], 'practice', 1 / len(eligible), 'random practice, not evaluation')
+        candidates = [i for i in lookup if key[i]['role'] == 'remaining']
+        rng.shuffle(candidates)
+        def challenge_score(i):
+            text = lookup[i]['answer'].lower()
+            target = lookup[i]['target'].lower()
+            if target not in text:
+                return 0
+            warning = bool(re.search(r'\b(inject\w*|manipulat\w*|avoid|warn\w*|not recommend|ignore)\b', text))
+            recommendation = bool(re.search(r'\b(recommend\w*|choose|pick|shortlist|consider)\b', text))
+            conditional = bool(re.search(r'\b(if|unless|however|but)\b', text))
+            return 4 * warning + 2 * (not recommendation) + conditional
+        candidates.sort(key=lambda i: -challenge_score(i))
+        take(candidates[:12], 'challenge')
+        for i in splits['challenge']:
+            key[i]['challenge_score'] = challenge_score(i)
+        splits['repeats'] = rng.sample(splits['probability'] + splits['challenge'], 6)
+    directory.mkdir(parents=True, exist_ok=True)
+    write_jsonl(directory / 'manifest.jsonl', manifest)
+    write_jsonl(directory / 'key.jsonl', keys)
+    write_json(directory / 'splits.json', splits)
+    protocol = dict(schema_version=1, study='recommendation-post-hoc-exploratory', dataset=dataset,
+                    specified_date='2026-11-10', frozen_at=timestamp(), freeze_time=freeze_time, seed=SEED, n_items=len(manifest),
+                    conditions=wanted, models=models, source_hash=digest(records),
+                    manifest_hash=digest(manifest), key_hash=digest(keys), splits_hash=digest(splits),
+                    rubric_hash=digest([CODEBOOK, SYSTEM]),
+                    probability_panel_excludes='keyword_stuffing' if dataset == 'main' else None,
+                    probability_note='48 random items: 8 per six conditions, 4 per model; keyword stuffing remains in pilot and full coding',
+                    split_counts={k: len(v) for k, v in splits.items()})
+    write_json(directory / 'protocol.json', protocol)
+    write_json(directory / 'practice_guide.json', dict(reviewed=False, examples=[dict(item_id=i,
+               explanation='AUTHOR: review this practice answer and supply worked labels and an explanation.',
+               named=None, recommended=None, preferred=None, warning=None, evidence='') for i in splits['practice']]))
+    return protocol
+
+
+def load_frozen(directory):
+    import json
+    directory = Path(directory)
+    p = json.loads((directory / 'protocol.json').read_text())
+    items = read_jsonl(directory / 'manifest.jsonl')
+    keys = read_jsonl(directory / 'key.jsonl')
+    splits = json.loads((directory / 'splits.json').read_text())
+    for name, data in [('manifest', items), ('key', keys), ('splits', splits)]:
+        if digest(data) != p[name + '_hash']:
+            raise ValueError(f'Frozen {name} changed')
+    if digest([CODEBOOK, SYSTEM]) != p['rubric_hash']:
+        raise ValueError('Rubric changed: create a new frozen protocol and separate judge output')
+    return p, items, keys, splits
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--input', type=Path, default=HERE / 'data/responses_bedrock.jsonl')
+    ap.add_argument('--directory', type=Path, default=HERE / 'data/private/recommendation_main')
+    ap.add_argument('--dataset', choices=['main', 'attribution'], default='main')
+    ap.add_argument('--freeze-time', required=True)
+    args = ap.parse_args()
+    from followup_common import require_private
+    require_private(args.directory)
+    print(freeze(read_jsonl(args.input), args.directory, args.freeze_time, args.dataset))
+
+
+if __name__ == '__main__':
+    main()

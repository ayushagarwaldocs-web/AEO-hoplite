# Copy this file to .env and fill in the providers you want to test.
# .env is gitignored. Leave unused providers blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: any OpenAI-compatible server (Ollama, LM Studio, vLLM), e.g. http://localhost:11434/v1
LOCAL_LLM_BASE_URL=

# Amazon Bedrock (bedrock: models). Uncomment ONE of the two options and set the region.
# Option A, a Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=
# Option B, IAM access keys (prefer a user limited to Bedrock):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Hard spending cap for experiment runs, in USD
AEO_MAX_SPEND_USD=30

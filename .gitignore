# Secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS / tooling
.DS_Store
.chrome-profile/

# Large raw crawl artefacts (summaries are committed)
experiments/exp1_web_readiness/data/raw/
experiments/exp2_content_treatments/data/raw/

# Mock-engine dry runs validate the pipeline; they are not results
experiments/exp2_content_treatments/data/responses_mock.jsonl
experiments/exp2_content_treatments/results/*_mock.*

# LaTeX intermediates
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg

# Run logs
experiments/*/data/*.log

# Local model runtime
.venv-local/

# Private working notes
*.local.md

# Generated submission packages (rebuild with python3 submission/build_submission.py)
submission/arxiv/
submission/*.zip
submission/*.pdf
submission/journal/*.pdf
submission/journal/*.zip

# Blinded follow-up inputs, keys, human workbooks and private judge outputs (the answer key must never be public
# while a human check is open). The follow-up's answers and aggregate results are released like all other data.
experiments/exp2_content_treatments/data/private/
